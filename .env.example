# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SEPOLIA_RPC_URL: Your Sepolia node URL (e.g. from Infura or Alchemy)
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY"

# PRIVATE_KEY: Your MetaMask account private key
PRIVATE_KEY="YOUR_METAMASK_PRIVATE_KEY"

# PINATA_API_KEY: For IPFS storage via Pinata
PINATA_API_KEY="YOUR_PINATA_API_KEY"

# PINATA_SECRET_API_KEY: For IPFS storage via Pinata
PINATA_SECRET_API_KEY="YOUR_PINATA_SECRET_KEY"
